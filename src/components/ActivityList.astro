---
// Awards and activities: a title plus one line each, in the Experience idiom.
interface Props {
  items: { title: string; text: string }[];
}
const { items } = Astro.props;
---

<ul class="activities">
  {
    items.map((a) => (
      <li class="reveal">
        <h3>{a.title}</h3>
        <p>{a.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .activities {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg) var(--space-xl);
    max-width: 820px;
  }

  .activities li {
    position: relative;
    padding-left: var(--space-lg);
  }

  .activities li::before {
    content: '▹';
    position: absolute;
    left: 0;
    top: 1px;
    color: var(--accent);
  }

  .activities h3 {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--heading);
  }

  .activities p {
    color: var(--muted);
    font-size: 0.875rem;
    margin-top: var(--space-xs);
  }

  @media (max-width: 768px) {
    .activities {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
