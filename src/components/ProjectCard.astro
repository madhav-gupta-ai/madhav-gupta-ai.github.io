---
const { project } = Astro.props;
const d = project.data;
const href = `/projects/${project.id}/`;
---

<article class="card reveal">
  <div class="card-top">
    <svg class="folder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
    </svg>
    {d.ongoing && <span class="badge">Ongoing</span>}
  </div>
  {d.context && <div class="context mono">{d.context}</div>}
  <h3>{d.hasPage ? <a href={href}>{d.title}</a> : d.title}</h3>
  <p>{d.summary}</p>
  <div class="tag-row">
    {d.tags.map((t: string) => <span class="tag">{t}</span>)}
  </div>
  {
    (d.hasPage || d.linkUrl || d.codeUrl || d.pdfUrl) && (
      <div class="actions">
        {d.hasPage && <a class="action mono" href={href}>Details →</a>}
        <div class="action-ext">
          {d.linkUrl && <a class="action mono" href={d.linkUrl}>Essay →</a>}
          {d.codeUrl && <a class="action mono" href={d.codeUrl} target="_blank" rel="noopener">GitHub ↗</a>}
          {d.pdfUrl && <a class="action mono" href={d.pdfUrl} target="_blank" rel="noopener">PDF ↗</a>}
        </div>
      </div>
    )
  }
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    padding: var(--space-lg);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    transition: transform var(--transition), border-color var(--transition);
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-md);
  }

  .folder {
    width: 36px;
    height: 36px;
    color: var(--accent);
  }

  .context {
    color: var(--accent);
    font-size: 0.72rem;
    margin-bottom: var(--space-sm);
  }

  .actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .action-ext {
    display: flex;
    gap: var(--space-sm);
    margin-left: auto;
  }

  .action {
    font-size: 0.7rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--rounded-sm);
    padding: 6px 10px;
    transition: color var(--transition), border-color var(--transition);
  }

  .action:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--heading);
  }

  h3 a {
    color: var(--heading);
    transition: color var(--transition);
  }

  h3 a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  p {
    color: var(--muted);
    font-size: 0.875rem;
    margin-top: var(--space-sm);
    flex: 1;
  }

  .tag-row {
    margin-top: var(--space-md);
  }
</style>
