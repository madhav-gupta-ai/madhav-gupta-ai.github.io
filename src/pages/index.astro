---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PaperCard from '../components/PaperCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ActivityList from '../components/ActivityList.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const allPapers = (await getCollection('papers'))
  .filter((p) => p.data.visible)
  .sort((a, b) => a.data.order - b.data.order);
const allProjects = (await getCollection('projects'))
  .filter((p) => p.data.visible)
  .sort((a, b) => a.data.order - b.data.order);

// featured=true on any paper/project moves it into the "// Featured" spotlight;
// the home Research/Projects sections show homepage=true, non-featured entries.
const featured = [
  ...allPapers.filter((p) => p.data.featured).map((entry) => ({ kind: 'paper', entry })),
  ...allProjects.filter((p) => p.data.featured).map((entry) => ({ kind: 'project', entry })),
].sort((a, b) => a.entry.data.order - b.entry.data.order);

const papers = allPapers.filter((p) => p.data.homepage && !p.data.featured);
const projects = allProjects.filter((p) => p.data.homepage && !p.data.featured);

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const experience = [
  {
    role: 'Deep Learning Intern',
    org: 'Michelin',
    where: 'Clermont-Ferrand, France',
    dates: 'Mar 2026 - Sep 2026',
    summary:
      'Research internship in the EXPLORE team (Industry 4.0, Department of Manufacturing), applying machine learning to tyre manufacturing.',
    link: { href: '/projects/michelin-extruder-screws/', label: 'How the work was done →' },
    points: [
      'Dynamic optimisation of extruder screws with genetic algorithms, 50x simulated flow (4 → 208 L/min).',
      'Made the extrusion simulator 125x faster, cutting a design search from over 8 hours to 4 minutes.',
      'Trained neural surrogates (GNN, CNN) on 200,000 designs for gradient-based design optimisation.',
      'A+ for the research internship, École Polytechnique.',
    ],
  },
  {
    role: 'ML Research Assistant',
    org: 'Centre for Inter-disciplinary AI, FLAME University',
    where: 'Pune, India',
    dates: 'Sep 2024 - Feb 2025',
    summary: 'Six months of research after my degree.',
    link: { href: '/research', label: 'See the publications →' },
    points: [
      'Authored 4 first-author papers, co-authored 3 more, and presented at international conferences.',
      'Research in scientific modelling and optimal control for industrial chemical reactors.',
    ],
  },
  {
    role: 'Student Research Assistant',
    org: 'FLAME University',
    where: 'Pune, India',
    dates: 'Sep 2023 - Dec 2023',
    summary:
      'Reviewed machine-learning methods for Local Climate Zone classification for urban heat islands in India, and identified the open problem: no large-scale, generalisable classifier exists.',
    points: [],
  },
  {
    role: 'AI and Machine Learning Intern',
    org: 'Wadhwani AI',
    where: 'Delhi, India',
    dates: 'Jun 2023 - Aug 2023',
    summary:
      "Media-based disease surveillance for the Government of India's Integrated Disease Surveillance Programme.",
    points: [
      'Extended the event-extraction pipeline from article titles to full article text; one approach found 108% more new events on the test articles.',
      'Benchmarked web content extractors on 1,980 pages in 11 languages; parallel extraction cut the time per 100 articles from 330 s to 95 s.',
      'Compared BERT, RoBERTa and XLM-R tokenisers on Indian languages; XLM-R handled them best.',
    ],
  },
  {
    role: 'Research Intern',
    org: 'PNTF Lab, the University of Alabama',
    where: 'Remote',
    dates: 'May 2022 - Jul 2022',
    summary:
      'Summer research internship in satellite navigation with the Precision, Navigation, Timing and Frequency Lab.',
    points: [
      'Wrote, from scratch, a Python algorithm that locates a GPS receiver from raw satellite navigation data.',
      "Checked it against the IISc Bangalore station: the computed position fell a few metres from the station's true coordinates.",
    ],
  },
  {
    role: 'ML Trainee (one-to-one)',
    org: 'FLAME University',
    where: 'Pune, India',
    dates: 'Nov 2021 - Apr 2022',
    summary: 'Machine-learning training with a faculty mentor, as the sole trainee.',
    points: [
      'Implemented decision trees, linear and logistic regression and random forests from scratch.',
      'Studied and implemented the Black Hole feature selection algorithm.',
    ],
  },
];

const education = [
  {
    degree: 'MScT in Trustworthy and Responsible AI',
    school: 'École Polytechnique (IP Paris)',
    where: 'Palaiseau, France',
    dates: '2025 - 2027',
    points: [
      'Coursework: Deep RL, Constrained RL, Optimisation for AI, Explainable AI, Verification of Neural Networks.',
      'M1 GPA 3.98, first quartile.',
    ],
  },
  {
    degree: 'BSc (Honours) in Computer Science',
    school: 'FLAME University',
    where: 'Pune, India',
    dates: '2020 - 2024',
    points: [
      "Dean's Roll of Honour for Academic Excellence.",
      'Honours thesis: Detecting Depression in Text using Word Embeddings.',
      'Fourth-year dissertation: A Hybridized Filtering-based Deep Contrastive Learning Model for Music Recommendation.',
    ],
  },
];

const activities = [
  // awards
  { title: 'Best Paper Award (3rd place), ICDMAI 2026', text: 'For the minority-class oversampling paper.' },
  { title: 'A+ for the Michelin research internship', text: 'École Polytechnique, 2026.' },
  // activities
  { title: 'Founding Member, IEEE Polytechnique', text: 'Co-founded the IEEE student chapter at École Polytechnique (X-IEEE) in 2025.' },
  { title: 'Class Representative, École Polytechnique', text: 'Represented the Trustworthy and Responsible AI cohort to Polytechnique leadership.' },
  { title: 'Adopt AI Hackathon (selected)', text: 'Disinformation and Democratic Sovereignty challenge, run by the French Presidency.' },
  { title: 'Co-founder, DotSlash Tech Club, FLAME', text: "Executive committee member of FLAME's first official tech club." },
  { title: 'Elected President, Philosophy Club, FLAME', text: 'Led a team of 15-20 and ran over 10 events.' },
  { title: 'Student Tutor, FLAME Q-Center', text: 'Linear algebra, Python and machine learning.' },
  { title: 'Invited Speaker, FLAME', text: 'Undergraduate seminar series.' },
];

const skills = [
  'Python',
  'PyTorch',
  'C++',
  'TensorFlow',
  'Java',
  'scikit-learn',
  'NumPy',
  'HF Transformers',
  'SciPy',
  'Gymnasium',
  'Pandas',
  'Linux',
  'Git',
  'Docker',
];
---

<Base>
  <div class="container">
    <!-- ============ HERO ============ -->
    <section class="hero">
      <p class="kicker mono reveal visible">Hi, my name is</p>
      <h1 class="reveal visible">{site.name}.</h1>
      <p class="hero-sub reveal visible">{site.tagline}</p>
      <p class="hero-blurb reveal visible">
        I'm a master's student in trustworthy AI at
        <a href="https://www.polytechnique.edu/en" target="_blank" rel="noopener">École Polytechnique</a>
        and a former deep learning intern at
        <a href="https://www.michelin.com/en" target="_blank" rel="noopener">Michelin</a>.
        I'm looking for a research internship from April 2027.
      </p>
      <div class="hero-cta reveal visible">
        <a class="btn btn-lg" href="#featured">See my work</a>
      </div>
    </section>

    <!-- ============ ABOUT ============ -->
    <section id="about" class="section">
      <SectionHeading num="01" title="About Me" />
      <div class="about-grid">
        <div class="about-text reveal">
          <p>
            Most of my work uses machine learning on physical systems: chemical reactors,
            tyre extruders, Formula 1 racing lines.
          </p>
          <p>
            At <a href="https://www.michelin.com/en" target="_blank" rel="noopener">Michelin</a>,
            I spent seven months making an extrusion simulator 125x faster, then used it to find
            a screw design with 50 times the simulated flow. Before Polytechnique, I studied
            computer science at FLAME University in India, where I wrote my first research papers.
          </p>
          <p>
            Outside work: philosophy, photography, football and Formula 1.
          </p>
          <p>Tools I work with:</p>
          <ul class="skills mono">
            {skills.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div class="portrait reveal">
          <img
            src="/images/portrait.jpg"
            alt="Madhav Gupta, smiling, in round glasses and a white T-shirt."
            width="743"
            height="743"
            loading="eager"
          />
          <svg class="border-trace" viewBox="0 0 300 300" aria-hidden="true">
            <defs>
              <radialGradient id="trace-grad" gradientUnits="userSpaceOnUse" cx="150" cy="150" r="212">
                <stop offset="0" style="stop-color: var(--glow)" stop-opacity="0.05"></stop>
                <stop offset="0.7" style="stop-color: var(--glow)" stop-opacity="0.3"></stop>
                <stop offset="1" style="stop-color: var(--glow)" stop-opacity="0.8"></stop>
              </radialGradient>
            </defs>
            <!-- two half-perimeter paths starting exactly at the TL and BR corner apexes,
                 traced 3.5 inside the photo edge (r=2.5 parallel of the 6px corner) so the
                 7px stroke hugs the frame with no uncovered corner wedge -->
            <path pathLength="1000" d="M 4.23 4.23 A 2.5 2.5 0 0 1 6 3.5 H 294 A 2.5 2.5 0 0 1 296.5 6 V 294 A 2.5 2.5 0 0 1 295.77 295.77" />
            <path pathLength="1000" d="M 295.77 295.77 A 2.5 2.5 0 0 1 294 296.5 H 6 A 2.5 2.5 0 0 1 3.5 294 V 6 A 2.5 2.5 0 0 1 4.23 4.23" />
          </svg>
        </div>
      </div>
    </section>

    <!-- ============ FEATURED ============ -->
    {
      featured.length > 0 && (
        <section id="featured" class="section">
          <SectionHeading title="Featured" />
          <div class="card-grid">
            {featured.map((f) =>
              f.kind === 'paper' ? (
                <PaperCard paper={f.entry} />
              ) : (
                <ProjectCard project={f.entry} />
              )
            )}
          </div>
        </section>
      )
    }

    <!-- ============ EXPERIENCE ============ -->
    <section id="experience" class="section">
      <SectionHeading num="02" title="Experience" />
      <div class="exp-list">
        {
          experience.map((e) => (
            <article class="exp reveal">
              <div class="exp-dates mono">{e.dates}</div>
              <div class="exp-body">
                <h3>
                  {e.role} <span class="exp-org">@ {e.org}</span>
                </h3>
                <div class="exp-where mono">{e.where}</div>
                <p class="exp-summary">{e.summary}</p>
                {e.points.length > 0 && (
                  <ul>
                    {e.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                )}
                {e.link && (
                  <a class="exp-link mono" href={e.link.href}>
                    {e.link.label}
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ EDUCATION ============ -->
    <section id="education" class="section">
      <SectionHeading num="03" title="Education" />
      <div class="exp-list">
        {
          education.map((e) => (
            <article class="exp reveal">
              <div class="exp-dates mono">{e.dates}</div>
              <div class="exp-body">
                <h3>
                  {e.degree} <span class="exp-org">@ {e.school}</span>
                </h3>
                <div class="exp-where mono">{e.where}</div>
                <ul>
                  {e.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ============ ACTIVITIES & AWARDS ============ -->
    <section id="activities" class="section">
      <SectionHeading title="Activities & Awards" />
      <ActivityList items={activities} />
    </section>

    <!-- ============ RESEARCH ============ -->
    <section id="research" class="section">
      <SectionHeading num="04" title="Selected Research" />
      <div class="card-grid">
        {papers.map((paper) => <PaperCard paper={paper} />)}
      </div>
      <p class="section-more reveal">
        <a class="mono" href="/research">View all publications →</a>
      </p>
    </section>

    <!-- ============ PROJECTS ============ -->
    <section id="projects" class="section">
      <SectionHeading num="05" title="Things I've Built" />
      <div class="card-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
      <p class="section-more reveal">
        <a class="mono" href="/projects">View all projects →</a>
      </p>
    </section>

    <!-- ============ WRITING ============ -->
    <section id="writing" class="section">
      <SectionHeading num="06" title="Writing" />
      <div class="post-list">
        {
          posts.map((post) => (
            <a class="post-row reveal" href={`/blog/${post.id}/`}>
              <span class="post-date mono">
                {post.data.date.toISOString().slice(0, 10)}
              </span>
              <span class="post-title">{post.data.title}</span>
            </a>
          ))
        }
      </div>
      <p class="section-more reveal">
        <a class="mono" href="/blog">View all writing →</a>
      </p>
    </section>

    <!-- ============ CONTACT ============ -->
    <section id="contact" class="section contact">
      <p class="kicker mono reveal">07. What's Next?</p>
      <h2 class="reveal">Get In Touch</h2>
      <p class="contact-blurb reveal">
        I'm looking for a 6-8 month research internship from April 2027, in machine
        learning for physical and industrial systems or in trustworthy AI. If you have a
        role or a project in mind, or a question about my work, email me.
      </p>
      <a class="btn btn-lg reveal" href={`mailto:${site.email}`}>Say Hello</a>
    </section>
  </div>
</Base>

<style>
  .hero {
    min-height: calc(85vh - 96px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-xxl) 0;
  }

  .kicker {
    color: var(--accent);
    margin-bottom: var(--space-md);
  }

  .hero h1 {
    font-size: clamp(40px, 7vw, 64px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .hero-sub {
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 700;
    color: var(--muted);
    line-height: 1.1;
    margin-top: var(--space-xs);
  }

  .hero-blurb {
    max-width: 540px;
    margin-top: var(--space-lg);
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .hero-cta {
    margin-top: var(--space-xl);
  }

  .section {
    padding: var(--space-xl) 0;
  }

  /* featured: pull the cards slightly closer to the heading */
  #featured :global(.section-heading) {
    margin-bottom: var(--space-lg);
  }

  /* about */
  .about-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .about-text p + p {
    margin-top: var(--space-md);
  }

  .about-text p:nth-last-child(2) {
    margin-top: var(--space-lg);
  }

  .skills {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(140px, 200px));
    gap: var(--space-sm) var(--space-md);
    margin-top: var(--space-md);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .skills li::before {
    content: '▹ ';
    color: var(--accent);
  }

  .portrait {
    position: relative;
    max-width: 300px;
    margin: var(--space-md) auto 0;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--rounded-md);
  }

  .portrait::before {
    content: '';
    position: absolute;
    top: 16px;
    left: 16px;
    width: 100%;
    height: 100%;
    border: 2px solid var(--accent);
    border-radius: var(--rounded-md);
    z-index: -1;
    transition: transform var(--transition);
  }

  .border-trace {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .border-trace path {
    fill: none;
    stroke: url(#trace-grad);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 1000 2000;
    stroke-dashoffset: 0;
    /* gentle anticlockwise roll-back when the pointer leaves */
    transition: stroke-dashoffset 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* on hover both halves unroll clockwise from their corners — quick but visible.
     -1010 overshoots the path end so the round caps fully clear (no leftover dot) */
  .portrait:hover .border-trace path {
    stroke-dashoffset: -1010;
    transition: stroke-dashoffset 0.85s cubic-bezier(0.55, 0, 0.45, 1);
  }

  .portrait:hover::before {
    transform: translate(-6px, -6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .border-trace path {
      transition: none;
    }
  }

  /* experience */
  .exp-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: 820px;
  }

  .exp {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: var(--space-lg);
  }

  .exp-dates {
    color: var(--muted);
    font-size: 0.72rem;
    padding-top: 5px;
  }

  .exp h3 {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .exp-org {
    color: var(--accent);
    font-weight: 600;
  }

  .exp-where {
    color: var(--muted);
    font-size: 0.72rem;
    margin-top: var(--space-xs);
  }

  .exp-summary {
    color: var(--text);
    font-size: 0.9rem;
    margin-top: var(--space-sm);
  }

  .exp ul {
    list-style: none;
    margin-top: var(--space-sm);
  }

  .exp-link {
    display: inline-block;
    font-size: 0.78rem;
    margin-top: var(--space-md);
  }

  .exp li {
    color: var(--muted);
    font-size: 0.9rem;
    padding-left: var(--space-lg);
    position: relative;
    margin-top: var(--space-sm);
  }

  .exp li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  /* cards */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .section-more {
    margin-top: var(--space-lg);
  }

  .section-more a {
    font-size: 0.8rem;
  }

  /* writing */
  .post-list {
    display: flex;
    flex-direction: column;
    max-width: 680px;
  }

  .post-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-lg);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--border);
    color: var(--heading);
    transition: color var(--transition);
  }

  .post-row:hover {
    text-decoration: none;
    color: var(--accent);
  }

  .post-date {
    color: var(--muted);
    font-size: 0.72rem;
    flex-shrink: 0;
  }

  .post-title {
    font-weight: 600;
  }

  /* contact */
  .contact {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    padding-bottom: var(--space-xxxl);
  }

  .contact .kicker {
    margin-bottom: var(--space-sm);
  }

  .contact h2 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 700;
  }

  .contact-blurb {
    color: var(--muted);
    margin: var(--space-md) 0 var(--space-xl);
  }

  @media (max-width: 768px) {
    /* pull the writing list slightly closer to its heading on phones */
    #writing :global(.section-heading) {
      margin-bottom: var(--space-lg);
    }

    .about-grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      margin: var(--space-lg) auto 0;
      max-width: 260px;
    }

    .exp {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
