---
import Base from '../layouts/Base.astro';
import PaperCard from '../components/PaperCard.astro';
import TagFilter from '../components/TagFilter.astro';
import { getCollection } from 'astro:content';

const papers = (await getCollection('papers'))
  .filter((p) => p.data.visible)
  .sort((a, b) => a.data.order - b.data.order);

// Filter topics = every tag in use, most common first.
const tagCounts = new Map<string, number>();
papers.forEach((p) =>
  p.data.tags.forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1))
);
const topics = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([t]) => t);
---

<Base title="Publications | Madhav Gupta">
  <div class="container">
    <header class="page-head">
      <p class="mono kicker">04. Research</p>
      <h1>Publications</h1>
      <p class="lead">
        Six published papers, five in press and a poster. Each page has the abstract
        or a summary, and the links. Filter by topic below.
      </p>
    </header>

    <TagFilter tags={topics} />

    <div class="card-grid">
      {
        papers.map((paper) => (
          <div class="filter-item" data-tags={paper.data.tags.join('|')}>
            <PaperCard paper={paper} />
          </div>
        ))
      }
    </div>

    <p class="back"><a class="mono" href="/">← Back home</a></p>
  </div>
</Base>

<style>
  .page-head {
    max-width: 680px;
    padding: var(--space-xl) 0 var(--space-xl);
  }

  .kicker {
    color: var(--accent);
    margin-bottom: var(--space-sm);
  }

  h1 {
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .lead {
    color: var(--muted);
    margin-top: var(--space-md);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .filter-item > :global(.card) {
    height: 100%;
  }

  .filter-item.hidden {
    display: none;
  }

  .filter-item.pop {
    animation: card-in 0.35s ease both;
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }

  .back {
    padding: var(--space-xxl) 0;
  }

  .back a {
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
